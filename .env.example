# Copy to .env and fill in. NEVER commit .env or the Google JSON file to the repository.

# --- Providers ---
# STT_PROVIDER:     azure (real service) | mock (simulated)
# EMOTION_PROVIDER: local (runs on this computer, recommended) | google (deprecated by Google) | mock
STT_PROVIDER=azure
EMOTION_PROVIDER=local

# --- Azure Speech (speech to text) ---
# Azure Portal -> your "Speech" resource -> Keys and Endpoint
AZURE_SPEECH_KEY=PASTE_KEY_1_HERE
AZURE_SPEECH_REGION=eastus          # the resource "Location/Region", e.g. eastus, southcentralus
SPEECH_LANGUAGE=en-US

# --- Google Cloud Vision (OPTIONAL: Google stopped returning emotions on 2026-10-15) ---
# Only needed with EMOTION_PROVIDER=google. Path to the service-account JSON (relative to the repo root)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
